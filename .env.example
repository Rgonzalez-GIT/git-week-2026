# ===== PostgreSQL =====
POSTGRES_DB=gitweek
POSTGRES_USER=gitweek
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# ===== Redis =====
REDIS_PORT=6379

# ===== Backend =====
NODE_ENV=development
PORT=3001

# Prisma (usada por backend/prisma7.config.ts)
DATABASE_URL=postgresql://gitweek:change_me@localhost:5432/gitweek?schema=public

# JWT (generar valores largos aleatorios, nunca commitear valores reales)
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Reservas (minutos)
RESERVATION_TTL_MINUTES=10

# Payment provider sandbox (placeholder hasta Fase 6)
PAYMENT_PROVIDER=sandbox