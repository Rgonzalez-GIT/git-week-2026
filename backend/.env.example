# Copia a .env y ajusta valores locales. Nunca commitear valores reales.
NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://gitweek:change_me@localhost:5432/gitweek?schema=public

RESERVATION_TTL_MINUTES=10
PAYMENT_PROVIDER=sandbox
# true habilita los endpoints de desarrollo /demo/* (sin autenticación). Nunca en producción.
DEMO_MODE=true

# Fase 12 - JWT. Genera secrets con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Fase 11 - Firma HMAC-SHA256 de webhooks de pago (misma fuente: openssl rand -hex 32)
WEBHOOK_SECRET=change_me

REDIS_HOST=localhost
REDIS_PORT=6379